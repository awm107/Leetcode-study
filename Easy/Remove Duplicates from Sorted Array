class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        int length = nums.size();
        if(length == 0){
            return 0;
        }
        else if(length == 1){
            return 1;
        }
        int i = 1;
        for(int j = i; j< length; j++){
            if(nums[i-1] != nums[j]){
                nums[i] = nums[j];
                i++;
            }
        }
        return i;
    }
};
